# BEGIN Activity4 ReserveIT - only new ReserveIT login accounts
local ReserveIT reserveit_owner,reserveit_app,reserveit_reporter,reserveit_dba scram-sha-256
local all reserveit_owner,reserveit_app,reserveit_reporter,reserveit_dba reject
host ReserveIT reserveit_owner,reserveit_app,reserveit_reporter,reserveit_dba 0.0.0.0/0 scram-sha-256
host ReserveIT reserveit_owner,reserveit_app,reserveit_reporter,reserveit_dba ::/0 scram-sha-256
host all reserveit_owner,reserveit_app,reserveit_reporter,reserveit_dba 0.0.0.0/0 reject
host all reserveit_owner,reserveit_app,reserveit_reporter,reserveit_dba ::/0 reject
# END Activity4 ReserveIT
